<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/crust"
    android:padding="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:orientation="vertical"
        android:background="@color/surface0"
        android:padding="24dp"
        android:gravity="center">

        <TextView
            android:id="@+id/lblLogo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="= LOFINOTES ="
            android:textColor="@color/lavender"
            android:textSize="32sp"
            android:textStyle="bold"
            android:fontFamily="monospace"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/lblSubtitulo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Espacio de Concentración Segura"
            android:textColor="@color/text"
            android:textSize="14sp"
            android:fontFamily="monospace"
            android:layout_marginBottom="32dp"
            android:gravity="center" />

        <Button
            android:id="@+id/btnGoogleLogin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:backgroundTint="@color/crust"
            android:text="[ INGRESAR CON GOOGLE ]"
            android:textColor="@color/text"
            android:fontFamily="monospace"
            android:textSize="14sp"
            android:padding="16dp"
            android:elevation="4dp" />

    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"
        android:text="v1.0 - Estética de 8-Bits"
        android:textColor="@color/text"
        android:alpha="0.5"
        android:fontFamily="monospace"
        android:textSize="12sp"
        android:layout_marginBottom="16dp" />

</RelativeLayout>